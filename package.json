{
  "name": "ara-render",
  "version": "2.0.0",
  "description": "ARA Instagram post render service",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node -e \"process.env.PUPPETEER_CACHE_DIR=require('path').resolve('.cache/puppeteer'); require('child_process').spawnSync(process.execPath, ['node_modules/puppeteer/install.mjs'], {stdio:'inherit'});\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "puppeteer": "^22.0.0",
    "axios": "^1.6.0",
    "multer": "^1.4.5-lts.1"
  }
}
